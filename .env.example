# Copia este archivo a .env.local y rellena con tus datos reales
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
OPENAI_API_KEY=your-openai-api-key
CONTENT_STUDIO_OPENAI_MODEL=
CONTENT_STUDIO_PREMIUM_MODEL=
CONTENT_STUDIO_FAST_MODEL=

# Opcional para comparar modelos en npm run model:bakeoff
ANTHROPIC_API_KEY=your-anthropic-api-key
CONTENT_STUDIO_ANTHROPIC_MODEL=
CONTENT_STUDIO_ANTHROPIC_FAST_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key
CONTENT_STUDIO_GEMINI_MODEL=
MISTRAL_API_KEY=your-mistral-api-key
CONTENT_STUDIO_MISTRAL_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe (opcional; la aplicación compila y arranca sin estas variables)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PRICE_STARTER=your-stripe-starter-price-id
STRIPE_PRICE_AGENCY=your-stripe-agency-price-id
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Firma HMAC opcional para webhooks salientes
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret

# Solo para npm run test:rls. Apunta a staging, NUNCA a producción.
SUPABASE_TEST_DB_URL=your-staging-database-url

# Techo mensual de generaciones IA por plan (opcional; hay valores por defecto).
# Los planes de pago se anuncian como ilimitados pero siempre tienen un tope
# de uso justo para poder controlar el margen.
AI_LIMIT_FREE=
AI_LIMIT_STARTER=
AI_LIMIT_AGENCY=

# Solo para npm run migrate:instagram (contraseña de Database en Supabase)
SUPABASE_DB_PASSWORD=your-supabase-database-password
SUPABASE_PROJECT_REF=your-supabase-project-ref
SUPABASE_DB_URL=your-supabase-database-url
SUPABASE_POOLER_HOST=your-supabase-pooler-host
SUPABASE_POOLER_PORT=6543

# Meta / Instagram API (Continuar con Instagram)
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
NEXT_PUBLIC_INSTAGRAM_APP_ID=your-instagram-app-id
# Fallback legacy:
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
